# Copy to .env and fill in. .env is git-ignored.
POSTGRES_USER=waterly
POSTGRES_PASSWORD=waterly
POSTGRES_DB=waterly_dev

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

API_PORT=5290
# Host port for the PostgreSQL container (5433 avoids clashing with a local PostgreSQL on 5432)
DB_PORT=5433
ASPNETCORE_ENVIRONMENT=Development
